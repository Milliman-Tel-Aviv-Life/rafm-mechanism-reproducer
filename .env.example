# Copy this file to .env and fill in the values.
# Values here override config.yaml at runtime.
# Never commit .env to git.

# Force one model on every stage (optional — defaults to config.yaml stage_models)
# RAFM_MODEL=claude-opus-4-8

# Override a single stage (optional — wins over config.yaml stage_models)
# RAFM_MODEL_STAGE4=claude-opus-4-8

# Override the APIM endpoint (optional)
# RAFM_ENDPOINT=https://apim-aiservices-prod-01.azure-api.net

# Override the API key (optional)
# RAFM_API_KEY=your-key-here
